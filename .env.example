# Copia este archivo a .env (no se sube a Git) o define estas variables en los secretos del entorno.

# Estado compartido: Postgres alojado (por ejemplo Neon desde el Marketplace de Vercel).
DATABASE_URL=postgresql://usuario:clave@servidor/oficina?sslmode=require

# Claves de los agentes por API. Solo viven donde corre oficina-mcp; nunca en la oficina web.
# Si una falta, el proveedor aparece como No configurado y no recibe tareas.
QWEN_API_KEY=
DEEPSEEK_API_KEY=

# Almacén de archivos del buzón (Vercel Blob, privado). El mismo token en Vercel y aquí.
BLOB_READ_WRITE_TOKEN=
# OFICINA_BLOB_ACCESS=private   # public solo si el almacén se creó público

# Opcionales
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# OFICINA_TIMEOUT_MS=120000
# Respaldo nativo: sin clave, las fichas de ese proveedor trabajan como subagentes de la sesión nativa.
# Activo por defecto; 0 lo apaga y el proveedor queda No configurado.
# OFICINA_RESPALDO_NATIVO=1
# OFICINA_DRIVER=neon   # neon (HTTPS) o pg (TCP). Por defecto: neon si la cadena es *.neon.tech

# Oficina web (solo en Vercel): acceso provisional
# OFICINA_USUARIO=
# OFICINA_CLAVE=
# OFICINA_SECRETO=
